# Production origins; local development may use an HTTP loopback origin.
ADMIN_API_BASE_URL=https://api.hometogether.kr
ADMIN_PUBLIC_ORIGIN=https://admin.hometogether.kr

# Replace these placeholders with separately generated deployment secrets.
ADMIN_SESSION_SECRET=<base64url-encoded-32-byte-key>
ADMIN_SESSION_MAX_AGE_SECONDS=604800
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<base64-encoded-aes-key>
